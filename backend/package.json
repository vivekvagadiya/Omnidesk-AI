    "@qdrant/js-client-rest": "^1.20.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "pdf-parse": "^2.4.5",
    "redis": "^4.7.0",
    "zod": "^3.24.2"
  }
